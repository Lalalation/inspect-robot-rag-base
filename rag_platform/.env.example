# ============================================================
# 复制为 .env 后按需修改；不要提交真实密钥到 Git
# ============================================================

# ---------------------------------------------------------- 服务
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------------------------------------------------------- 对话模型
# 任意 OpenAI 兼容服务：填好 BASE_URL / API_KEY / CHAT_MODEL 即可
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
CHAT_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# 其他服务示例（任选其一）：
# DeepSeek（无 Embedding 服务，需单独配置向量模型）
# LLM_BASE_URL=https://api.deepseek.com
# CHAT_MODEL=deepseek-chat
#
# OpenAI
# LLM_BASE_URL=https://api.openai.com
# CHAT_MODEL=gpt-4o-mini
#
# 硅基流动（对话与向量共用一个 Key）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------------------------------------------------- Embedding
# 留空则复用上面的 LLM_BASE_URL / LLM_API_KEY
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
EMBED_BATCH_SIZE=16

# 常见组合：
# 通义千问 text-embedding-v3        → EMBED_DIM=1024
# OpenAI text-embedding-3-small     → EMBED_DIM=1536
# 硅基流动 BAAI/bge-m3              → EMBED_BASE_URL=https://api.siliconflow.cn/v1，EMBED_DIM=1024
# 切换 EMBED_MODEL / EMBED_DIM 后必须调用 POST /api/v1/documents/reindex 重建集合

# ---------------------------------------------------------- Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=robot_ops_docs

# ---------------------------------------------------------- 检索与切片
CHUNK_SIZE=480
CHUNK_OVERLAP=80
TOP_K=4
SCORE_THRESHOLD=0.35

# ---------------------------------------------------------- Redis
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=600
CACHE_MAX_MEMORY_ENTRIES=256

# ---------------------------------------------------------- SQLite
SQLITE_PATH=db/robot_data.db
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=5

# ---------------------------------------------------------- 文档
KNOWLEDGE_DIR=knowledge_docs
UPLOAD_DIR=knowledge_docs/uploaded
MAX_UPLOAD_MB=2
